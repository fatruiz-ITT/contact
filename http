<script>
  // 1. MATRIX BACKGROUND & TOGGLE
  const canvas = document.getElementById('matrix-bg');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  const chars = '01<>/[]{}_-+=&*^%$#@!|';
  const charArr = chars.split('');
  const fontSize = 14;
  const columns = canvas.width / fontSize;
  const drops = Array.from({ length: columns }).fill(1);

  function drawMatrix() {
    ctx.fillStyle = 'rgba(3, 7, 18, 0.08)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#38bdf8';
    ctx.font = fontSize + 'px monospace';

    for (let i = 0; i < drops.length; i++) {
      const text = charArr[Math.floor(Math.random() * charArr.length)];
      ctx.fillText(text, i * fontSize, drops[i] * fontSize);
      if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
      drops[i]++;
    }
  }
  let matrixInterval = setInterval(drawMatrix, 35);

  let matrixActive = true;
  function toggleMatrixState() {
    matrixActive = !matrixActive;
    canvas.style.opacity = matrixActive ? '0.22' : '0';
  }

  document.getElementById('btnToggleMatrix').addEventListener('click', toggleMatrixState);
  document.getElementById('btnToggleMatrixMobile').addEventListener('click', toggleMatrixState);

  window.addEventListener('resize', () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  });

  // 2. MOBILE ORB MENU CONTROLLER
  const mobileNavOrb = document.getElementById('mobileNavOrb');
  const mobileDropdownMenu = document.getElementById('mobileDropdownMenu');
  const mobileNavIcon = document.getElementById('mobileNavIcon');

  mobileNavOrb.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = mobileDropdownMenu.classList.contains('show-menu');
    if (isOpen) {
      mobileDropdownMenu.classList.remove('show-menu');
      mobileNavOrb.classList.remove('active-orb');
      mobileNavIcon.className = 'fa-solid fa-compass';
    } else {
      mobileDropdownMenu.classList.add('show-menu');
      mobileNavOrb.classList.add('active-orb');
      mobileNavIcon.className = 'fa-solid fa-xmark';
    }
  });

  document.addEventListener('click', (e) => {
    if (!mobileDropdownMenu.contains(e.target) && !mobileNavOrb.contains(e.target)) {
      mobileDropdownMenu.classList.remove('show-menu');
      mobileNavOrb.classList.remove('active-orb');
      mobileNavIcon.className = 'fa-solid fa-compass';
    }
  });

  document.querySelectorAll('.mobile-drop-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileDropdownMenu.classList.remove('show-menu');
      mobileNavOrb.classList.remove('active-orb');
      mobileNavIcon.className = 'fa-solid fa-compass';
    });
  });

  // 3. SPOTLIGHT GLOW EFFECT ON CARDS
  document.querySelectorAll('.glass-panel').forEach((panel) => {
    panel.addEventListener('mousemove', (e) => {
      const rect = panel.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      panel.style.setProperty('--mouse-x', `${x}px`);
      panel.style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // 4. TIJUANA LIVE CLOCK
  function updateTijuanaClock() {
    const clockEl = document.getElementById('liveClock');
    if (!clockEl) return;
    const now = new Date();
    const timeStr = now.toLocaleTimeString('en-US', {
      timeZone: 'America/Tijuana',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true
    });
    clockEl.textContent = timeStr;
  }
  setInterval(updateTijuanaClock, 1000);
  updateTijuanaClock();

  // 5. ROBOT COMPANION LOGIC
  const botCompanion = document.getElementById('botCompanion');
  const botAvatar = document.getElementById('botAvatar');
  const botSpeech = document.getElementById('botSpeech');
  const pupilLeft = document.getElementById('botPupilLeft');
  const pupilRight = document.getElementById('botPupilRight');
  const btnBotDance = document.getElementById('btnBotDance');

  window.addEventListener('mousemove', (e) => {
    if (!botAvatar) return;
    const rect = botAvatar.getBoundingClientRect();
    const botCenterX = rect.left + rect.width / 2;
    const botCenterY = rect.top + rect.height / 2;

    const angle = Math.atan2(e.clientY - botCenterY, e.clientX - botCenterX);
    const distance = Math.min(3, Math.hypot(e.clientX - botCenterX, e.clientY - botCenterY) / 40);

    const moveX = Math.cos(angle) * distance;
    const moveY = Math.sin(angle) * distance;

    pupilLeft.style.transform = `translate(${moveX}px, ${moveY}px)`;
    pupilRight.style.transform = `translate(${moveX}px, ${moveY}px)`;
  });

  document.querySelectorAll('.form-track-input').forEach((input) => {
    input.addEventListener('focus', () => {
      botCompanion.classList.add('typing-hide');
    });
    input.addEventListener('blur', () => {
      botCompanion.classList.remove('typing-hide');
    });
  });

  let isDancing = false;
  btnBotDance.addEventListener('click', () => {
    if (isDancing) return;
    isDancing = true;
    botAvatar.classList.add('dancing');
    botSpeech.textContent = '♫ Boop-beep! Autonomous dance routine activated! ♫';
    btnBotDance.innerHTML = '<i class="fa-solid fa-pause"></i> Dancing!';

    setTimeout(() => {
      botAvatar.classList.remove('dancing');
      botSpeech.textContent = 'Tracking cursor... Ready for deployment.';
      btnBotDance.innerHTML = '<i class="fa-solid fa-music"></i> Dance';
      isDancing = false;
    }, 4500);
  });

  // 6. TABS & CAROUSEL
  function openTab(evt, tabId) {
    document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    evt.currentTarget.classList.add('active');
  }

  function scrollCarousel(offset) {
    document.getElementById('carouselWrapper').scrollBy({ left: offset, behavior: 'smooth' });
  }

  document.getElementById('btnCV').addEventListener('click', () => {
    document.getElementById('modalCV').showModal();
  });

  // 7. GOOGLE APPS SCRIPT FORM TRANSMISSION
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbx5RLOCZfa_Y0JOQ1xG_ovViKKIGj8CZD-9IhX_KrUMuwV3YqrMIglMPaO94OcaJvGa/exec';

  const hubForm = document.getElementById('hubForm');
  const formMsg = document.getElementById('formMsg');
  const btnSubmit = document.getElementById('btnSubmit');

  hubForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const userName = document.getElementById('userName').value.trim();
    const userEmail = document.getElementById('userEmail').value.trim();
    const inquiryType = document.getElementById('inquiryType').value;
    const userMessage = document.getElementById('userMessage').value.trim();
    const userLink = document.getElementById('userLink').value.trim();

    if (!userName || !userEmail || !userMessage) {
      formMsg.style.display = 'block';
      formMsg.innerHTML = `
        <div class="status-card error">
          <div class="status-header">
            <div class="status-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="status-title">Incomplete Submission</div>
          </div>
          <div class="status-desc">Please fill out all required fields before transmitting.</div>
        </div>
      `;
      return;
    }

    btnSubmit.disabled = true;
    btnSubmit.innerHTML = '<i class="fa-solid fa-satellite-dish fa-spin"></i> Encrypting & Transmitting...';
    formMsg.style.display = 'none';

    const payload = {
      userName: userName,
      userEmail: userEmail,
      inquiryType: inquiryType,
      userMessage: userMessage,
      userLink: userLink || 'None provided'
    };

    try {
      await fetch(SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      formMsg.style.display = 'block';
      formMsg.innerHTML = `
        <div class="status-card success">
          <div class="status-header">
            <div class="status-icon"><i class="fa-solid fa-check"></i></div>
            <div class="status-title">Transmission Delivered</div>
          </div>
          <div class="status-desc">
            Dispatched to <strong>ruizgarciafatimadejesus@gmail.com</strong>.<br/>
            An automated receipt has been sent to <strong>${userEmail}</strong>.
            <div class="status-badge">STATUS: 200 OK • SRE DISPATCHED</div>
          </div>
        </div>
      `;
      hubForm.reset();
    } catch (err) {
      formMsg.style.display = 'block';
      formMsg.innerHTML = `
        <div class="status-card error">
          <div class="status-header">
            <div class="status-icon"><i class="fa-solid fa-xmark"></i></div>
            <div class="status-title">Transmission Error</div>
          </div>
          <div class="status-desc">
            Direct route failed. Please reach out via <a href="https://www.linkedin.com/in/fatima-ruiz" style="color:#38bdf8; text-decoration:underline;">LinkedIn</a> or WhatsApp.
          </div>
        </div>
      `;
      console.error('Transmission error:', err);
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = '<i class="fa-solid fa-lock"></i> Send Secure Message';
    }
  });
</script>

